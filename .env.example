# Copy to .env and fill in a real value — .env is gitignored.
#
# Password for the single "root" login (see src/auth). This is a client-side
# gate only: PulseBoard has no backend, so this value ends up readable inside
# the built JS bundle. It stops casual access, not a determined attacker.
VITE_ROOT_PASSWORD=

# Set to "true" to skip the login screen entirely. Playwright sets this
# automatically for `npm test` / `npm run screenshot` (see playwright.config.ts)
# so the acceptance suite can reach the dashboard without signing in.
# VITE_DISABLE_AUTH=true
